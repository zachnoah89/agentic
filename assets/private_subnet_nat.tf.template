# Phase 2 Mitigation: Private Subnet and Cloud NAT
# Use this when a VM requires outbound internet access (e.g., to download packages)
# but we want to remove its external Public IP to prevent inbound SSH brute-forcing
# or unauthorized external access.

# 1. Create a Private Subnetwork
resource "google_compute_subnetwork" "private_subnet" {
  name                     = "lab-private-subnet"
  ip_cidr_range            = "10.0.1.0/24"
  region                   = var.gcp_region
  network                  = "default" # Or your custom VPC name
  private_ip_google_access = true
}

# 2. Deploy Cloud Router
resource "google_compute_router" "nat_router" {
  name    = "lab-nat-router"
  region  = var.gcp_region
  network = "default"
  project = var.gcp_project_id
}

# 3. Deploy Cloud NAT
resource "google_compute_router_nat" "nat_config" {
  name                               = "lab-nat-config"
  router                             = google_compute_router.nat_router.name
  region                             = var.gcp_region
  nat_ip_allocate_option             = "AUTO_ONLY"
  source_subnetwork_ip_ranges_to_nat = "ALL_SUBNETWORKS_ALL_IP_RANGES"
  project                            = var.gcp_project_id
}

# Ensure your google_compute_instance block drops the `access_config` block
# so it does not get a public IP.
